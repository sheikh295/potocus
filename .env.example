# Copy to .env and fill in as needed. Never commit .env.

# Optional override for the OpenAI-compatible Ollama endpoint.
# POTOCUS_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Optional override for the native Ollama API (health / tags).
# POTOCUS_OLLAMA_NATIVE_URL=http://127.0.0.1:11434

# NIST NVD API key (optional, for get_cve_details later).
# NVD_API_KEY=
